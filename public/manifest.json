  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+typestrike",
      "url": "/?mode=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=load-words",
      "name": "TypeStrike Custom Word List",
      "icons": [
        {
          "src": "/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ],
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "TypeStrike Daily Target",
      "short_name": "Daily Target",
      "description": "Quick daily speed workout widget",
      "tag": "typestrike-daily",
      "template": "widget-daily",
      "ms_ac_template": "/widgets/daily.json",
      "data": "/widgets/daily-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-wide.png",
          "sizes": "1280x720",
          "type": "image/png",
          "label": "Widget Preview"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 440
  },
  "note_taking": {
    "new_note_url": "/?action=practice-notes"
